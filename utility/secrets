#!/usr/bin/env bash
#
# secrets — a small wrapper over sops + age.
#
# sops owns the file format and the editing; age owns the key. This script is
# only the ergonomics: it keeps values off the command line, off the shell
# history and out of `ps`, and gives `export` a predictable contract.
#
#   secrets init
#   secrets set GITHUB_TOKEN            # value read from stdin, hidden
#   eval "$(secrets export)"
#
# The store is one sops-encrypted JSON file. It is safe to commit; the age
# private key is not, and lives outside any repo.
set -euo pipefail

STORE=${SECRETS_FILE:-$HOME/.config/mise/secrets.json}
KEY=${SOPS_AGE_KEY_FILE:-$HOME/.config/mise/age.txt}

die() { printf 'secrets: %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed (mise install)"; }

require_store() {
    [[ -f $STORE ]] || die "no store at $STORE — run 'secrets init'"
    [[ -f $KEY ]] || die "no age key at $KEY — run 'secrets init'"
}

# Decrypt once per invocation. Never write plaintext to disk.
plain() { require_store; need sops; SOPS_AGE_KEY_FILE=$KEY sops -d --output-type json "$STORE"; }

# Re-encrypt from stdin, atomically, so an interrupted write cannot truncate
# the store and take every secret with it.
# The public key is a comment inside the age key file, so the recipient is
# always derivable and there is no .sops.yaml to keep in step with the store.
recipient() { grep -o 'age1[0-9a-z]*' "$KEY" | tail -1; }

save() {
    local rcpt; rcpt=$(recipient); [[ -n $rcpt ]] || die "no age recipient found in $KEY"
    local tmp; tmp=$(mktemp "${STORE}.XXXXXX"); chmod 600 "$tmp"
    if sops -e --age "$rcpt" --input-type json --output-type json /dev/stdin > "$tmp"; then
        mv -f "$tmp" "$STORE"
    else
        rm -f "$tmp"; die "encryption failed; store left unchanged"
    fi
}

cmd_init() {
    need age-keygen; need sops
    [[ -d $(dirname "$KEY")   ]] || install -d -m 700 "$(dirname "$KEY")"
    [[ -d $(dirname "$STORE") ]] || install -d -m 700 "$(dirname "$STORE")"

    local created=false
    if [[ ! -f $KEY ]]; then age-keygen -o "$KEY" 2>/dev/null; chmod 600 "$KEY"; created=true; fi

    # A key inside a worktree is one `git add -A` away from being published.
    if git -C "$(dirname "$KEY")" rev-parse --git-dir >/dev/null 2>&1; then
        die "$KEY is inside a git repo — move it out before storing anything"
    fi

    local pub; pub=$(recipient)
    [[ -f $STORE ]] || printf '{}' | save

    printf 'store : %s\npublic: %s\n' "$STORE" "$pub"

    $created || return 0
    cat >&2 <<WARN

  ============================================================
   BACK UP YOUR PRIVATE KEY NOW
  ============================================================
   $KEY

   This key is the only way to read $STORE.
   Lose it and every secret is gone for good. There is no
   recovery and no reset.

   Back it up before you store anything:
     - paste the file into your password manager, or
     - copy it to another machine you control

   Never commit it. Never paste it into a chat. Anyone holding
   it can read every secret you encrypt.
  ============================================================

WARN
    printf 'Type BACKED-UP to continue: ' >&2
    local ack; read -r ack
    [[ $ack == BACKED-UP ]] || die "stopped — back up $KEY, then run 'secrets init' again"
}

cmd_get() {
    [[ $# -eq 1 ]] || die "usage: secrets get <name>"
    need jq
    # jq -e exits non-zero when the key is absent, so a missing secret is an
    # error rather than an empty line the caller might use by accident.
    local v
    v=$(plain | jq -er --arg k "$1" '.[$k]') || die "no such secret: $1"
    printf '%s\n' "$v"
}

cmd_set() {
    [[ $# -ge 1 ]] || die "usage: secrets set <name> [value]"
    need jq
    local name=$1 value
    if [[ $# -ge 2 ]]; then
        # Discouraged: an argument is visible in `ps` and in shell history.
        value=$2
    elif [[ -t 0 ]]; then
        printf 'value for %s (hidden): ' "$name" >&2
        read -rs value; printf '\n' >&2
    else
        value=$(cat)                      # piped in
    fi
    [[ -n $value ]] || die "refusing to store an empty value for $name"
    plain | jq --arg k "$name" --arg v "$value" '.[$k]=$v' | save
    printf 'set %s\n' "$name"
}

cmd_delete() {
    [[ $# -eq 1 ]] || die "usage: secrets delete <name>"
    need jq
    plain | jq -e --arg k "$1" 'has($k)' >/dev/null || die "no such secret: $1"
    plain | jq --arg k "$1" 'del(.[$k])' | save
    printf 'deleted %s\n' "$1"
}

cmd_list() { need jq; plain | jq -r 'keys[]'; }

cmd_search() {
    [[ $# -eq 1 ]] || die "usage: secrets search <pattern>"
    # Names only. Matching on values would print them to the terminal.
    cmd_list | grep -iE -- "$1" || die "no name matches: $1"
}

cmd_export() {
    need jq
    local file="" format=shell on_missing=throw
    while [[ $# -gt 0 ]]; do
        case $1 in
            --file)       file=${2:?--file needs a path}; shift 2 ;;
            --format)     format=${2:?--format needs a value}; shift 2 ;;
            --on-missing) on_missing=${2:?--on-missing needs a value}; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    case $format in shell|dotenv|json) ;; *) die "bad --format: $format" ;; esac
    case $on_missing in throw|empty|keep) ;; *) die "bad --on-missing: $on_missing" ;; esac

    local json; json=$(plain)

    # Without --file, export everything. With it, the file lists the names
    # wanted (KEY or KEY=...), and --on-missing decides what an absent one does.
    local names
    if [[ -n $file ]]; then
        [[ -f $file ]] || die "no such file: $file"
        names=$(sed -e 's/#.*//' -e 's/^[[:space:]]*//' "$file" \
                | grep -oE '^[A-Za-z_][A-Za-z0-9_]*' || true)
    else
        names=$(printf '%s' "$json" | jq -r 'keys[]')
    fi
    [[ -n $names ]] || return 0

    local out='{}' n v
    while IFS= read -r n; do
        [[ -n $n ]] || continue
        if v=$(printf '%s' "$json" | jq -er --arg k "$n" '.[$k]' 2>/dev/null); then :
        else
            case $on_missing in
                throw) die "missing secret: $n" ;;
                empty) v="" ;;
                keep)  continue ;;      # leave it to whatever already set it
            esac
        fi
        out=$(printf '%s' "$out" | jq --arg k "$n" --arg v "$v" '.[$k]=$v')
    done <<< "$names"

    case $format in
        # @sh quotes the value, so a password containing a quote or a space
        # cannot break out of the assignment when this is eval'd.
        shell)  printf '%s' "$out" | jq -r 'to_entries[] | "export \(.key)=\(.value|@sh)"' ;;
        dotenv) printf '%s' "$out" | jq -r 'to_entries[] | "\(.key)=\(.value)"' ;;
        json)   printf '%s' "$out" | jq -S . ;;
    esac
}

usage() {
    cat <<'USAGE'
secrets — sops + age, with the sharp edges filed off

  init                               Create the age key and an empty store
  get <name>                         Print secret to stdout
  set <name> [value]                 Store secret (value from stdin if omitted)
  delete|rm <name>                   Delete a secret
  list|ls                            List all secret names
  search <pattern>                   Regex search over names (case-insensitive)

  export [--file .env]               Print 'export KEY=VAL' lines for shell eval
    [--format shell|dotenv|json]     Default: shell
    [--on-missing throw|empty|keep]  Default: throw

Environment:
  SECRETS_FILE        store path     (default ~/.config/mise/secrets.json)
  SOPS_AGE_KEY_FILE   age key path   (default ~/.config/mise/age.txt)

Examples:
  secrets set GITHUB_TOKEN                 # prompts, input hidden
  eval "$(secrets export)"                 # load everything into this shell
  secrets export --file .env.example --on-missing empty --format dotenv
USAGE
}

case ${1:-help} in
    init)          shift; cmd_init "$@" ;;
    get)           shift; cmd_get "$@" ;;
    set)           shift; cmd_set "$@" ;;
    delete|rm)     shift; cmd_delete "$@" ;;
    list|ls)       shift; cmd_list "$@" ;;
    search)        shift; cmd_search "$@" ;;
    export)        shift; cmd_export "$@" ;;
    help|-h|--help) usage ;;
    *)             usage; exit 2 ;;
esac
